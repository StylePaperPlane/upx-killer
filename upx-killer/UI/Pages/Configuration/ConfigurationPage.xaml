<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="upx_killer.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:upx_killer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StaticHelpButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid
        AutomationProperties.AutomationId="ConfigurationPageRoot"
        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
        <Border
            AutomationProperties.AutomationId="TemporaryFilesTile"
            Margin="24"
            Padding="0"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderThickness="0">
            <StackPanel Spacing="24">
                <TextBlock
                    x:Uid="TemporaryFilesTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Uid="TemporaryDirectoryLabel"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        x:Name="TemporaryDirectoryTextBox"
                        AutomationProperties.AutomationId="TemporaryDirectoryTextBox"
                        Grid.Row="1"
                        IsReadOnly="True"
                        IsTabStop="False"
                        Text="{x:Bind ViewModel.TemporaryDirectory, Mode=OneWay}" />
                    <Button
                        x:Name="SelectTemporaryDirectoryButton"
                        AutomationProperties.AutomationId="SelectTemporaryDirectoryButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="40"
                        MinHeight="32"
                        Content="&#x2026;"
                        Command="{x:Bind ViewModel.SelectTemporaryDirectoryCommand, Mode=OneWay}"
                        TabIndex="0" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Uid="AutoDeleteTemporaryFilesLabel"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Button
                        x:Name="AutoDeleteHelpButton"
                        AutomationProperties.AutomationId="AutoDeleteHelpButton"
                        AutomationProperties.HelpText="{x:Bind ViewModel.AutoDeleteHelpText, Mode=OneWay}"
                        Grid.Column="1"
                        Style="{StaticResource StaticHelpButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.AutoDeleteHelpText, Mode=OneWay}"
                        TabIndex="1">
                        <Border
                            Width="16"
                            Height="16"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="?"
                                FontFamily="Segoe UI"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextLineBounds="Tight"
                                TextAlignment="Center" />
                        </Border>
                    </Button>

                    <ComboBox
                        x:Name="AutoDeleteComboBox"
                        AutomationProperties.AutomationId="AutoDeleteComboBox"
                        Grid.Column="2"
                        MinWidth="144"
                        SelectedIndex="{x:Bind ViewModel.AutoDeleteSelectedIndex, Mode=TwoWay}"
                        TabIndex="2">
                        <ComboBoxItem x:Uid="AutoDeleteYesOption" />
                        <ComboBoxItem x:Uid="AutoDeleteNoOption" />
                    </ComboBox>
                </Grid>

                <Border
                    Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Spacing="16">
                    <TextBlock
                        x:Uid="WslRuntimeTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="WslDistributionLabel"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button
                            x:Name="RefreshWslDistributionsButton"
                            x:Uid="RefreshWslDistributionsButton"
                            AutomationProperties.AutomationId="RefreshWslDistributionsButton"
                            Grid.Column="1"
                            MinHeight="32"
                            Command="{x:Bind ViewModel.RefreshWslDistributionsCommand, Mode=OneWay}"
                            TabIndex="3" />
                        <ComboBox
                            x:Name="WslDistributionComboBox"
                            AutomationProperties.AutomationId="WslDistributionComboBox"
                            Grid.Column="2"
                            MinWidth="144"
                            ItemsSource="{x:Bind ViewModel.WslDistributions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedWslDistributionIndex, Mode=TwoWay}"
                            TabIndex="4" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
