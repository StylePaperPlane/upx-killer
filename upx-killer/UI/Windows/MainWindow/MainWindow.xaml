<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="upx_killer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="RootNavigationView"
        AutomationProperties.AutomationId="RootNavigationView"
        AlwaysShowHeader="False"
        CompactPaneLength="48"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="False"
        IsSettingsVisible="False"
        OpenPaneLength="200"
        PaneDisplayMode="LeftCompact">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="OverviewNavigationItem"
                x:Uid="OverviewNavigationItem"
                AutomationProperties.AutomationId="OverviewNavigationItem"
                Icon="Home"
                Tag="overview" />
            <NavigationViewItem
                x:Name="ConfigurationNavigationItem"
                x:Uid="ConfigurationNavigationItem"
                AutomationProperties.AutomationId="ConfigurationNavigationItem"
                Icon="Setting"
                Tag="configuration" />
        </NavigationView.MenuItems>

        <Frame
            x:Name="ContentFrame"
            AutomationProperties.AutomationId="ContentFrame" />
    </NavigationView>
</Window>
