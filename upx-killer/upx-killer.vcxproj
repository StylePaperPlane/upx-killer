          DependsOnTargets="GetWindowsAppSDKNativePlatform">
    <ItemGroup>
      <_UnsupportedWindowsAppSDKLanguageResource
          Include="%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-$(NativePlatform)\native\**\*.mui"
          Exclude="%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-$(NativePlatform)\native\en-us\*.mui;%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-$(NativePlatform)\native\zh-CN\*.mui" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="@(_UnsupportedWindowsAppSDKLanguageResource)" />
    </ItemGroup>
  </Target>
  <!-- Also remove obsolete satellite directories left by an older incremental
       build that copied every Windows App SDK language. -->
  <Target Name="RemoveStaleWindowsAppSDKLanguageDirectories" AfterTargets="Build">
    <ItemGroup>
      <_StaleWindowsAppSDKLanguageResource
          Include="$(OutDir)*\*.mui"
          Exclude="$(OutDir)en-us\*.mui;$(OutDir)zh-CN\*.mui" />
      <_StaleWindowsAppSDKLanguageDirectory
          Include="@(_StaleWindowsAppSDKLanguageResource->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <RemoveDir Directories="@(_StaleWindowsAppSDKLanguageDirectory)" />
  </Target>
